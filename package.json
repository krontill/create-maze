{
  "name": "maze-builder",
  "version": "0.1.2",
  "description": "Framework-agnostic, pure TypeScript maze generation library",
  "type": "module",
  "main": "./dist/maze-builder.cjs",
  "module": "./dist/maze-builder.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/maze-builder.js",
      "require": "./dist/maze-builder.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "demo": "vite",
    "build": "vite build",
    "build:sandbox": "vite build --config vite.sandbox.config.ts",
    "preview:sandbox": "vite preview --config vite.sandbox.config.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "maze",
    "maze-generation",
    "algorithm",
    "procedural-generation",
    "typescript",
    "pathfinding",
    "labyrinth",
    "dfs",
    "prims",
    "kruskals"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/krontill/maze-builder.git"
  },
  "homepage": "https://github.com/krontill/maze-builder",
  "bugs": {
    "url": "https://github.com/krontill/maze-builder/issues"
  },
  "author": "Siarhei Shcherba aka Krontill",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^4.1.6"
  }
}

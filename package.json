{
  "name": "maze-builder",
  "version": "0.1.0",
  "description": "Framework-agnostic, pure TypeScript maze generation library",
  "type": "module",
  "main": "./dist/maze-builder.cjs",
  "module": "./dist/maze-builder.js",
  "exports": {
    ".": {
      "import": "./dist/maze-builder.js",
      "require": "./dist/maze-builder.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["maze", "maze-generation", "algorithm", "dfs", "prims", "kruskals"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^4.1.6"
  }
}
